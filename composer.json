{
    "name": "marnold-ebsco/phpfolioclient",
    "description": "PHP client library for the FOLIO library services platform API.",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "phpFolioClient\\": "src/folio/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "phpFolioClient\\Tests\\": "tests/"
        }
    }
}
